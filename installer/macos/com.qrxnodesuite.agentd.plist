<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.qrxnodesuite.agentd</string>

  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/opt/qrx-node-suite/bin/agentd</string>
    <string>-config</string>
    <string>/usr/local/etc/qrx-node-suite/agent.json</string>
  </array>

  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>

  <key>StandardOutPath</key>
  <string>/usr/local/var/log/qrx-node-suite/agentd.log</string>
  <key>StandardErrorPath</key>
  <string>/usr/local/var/log/qrx-node-suite/agentd.log</string>
</dict>
</plist>
