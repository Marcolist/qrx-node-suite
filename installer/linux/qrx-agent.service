[Unit]
Description=QRX Node Suite Agent
Documentation=https://github.com/Marcolist/qrx-node-suite
After=network-online.target
Wants=network-online.target
# Complements agentd's own in-process crash-loop guard (BootGuard,
# agent/updates/bootguard.go, 3 failed boots by default): BootGuard can only
# act once a new binary's Go runtime actually starts running, so it can
# never catch one the kernel can't even exec() at all (wrong architecture,
# a truncated/corrupted extraction, a stripped executable bit). This is
# systemd's own, OS-level circuit breaker for exactly that case -- see
# install.sh's install_systemd_service() for the fuller rationale (F07 fix,
# external security audit).
StartLimitIntervalSec=300
StartLimitBurst=8

[Service]
Type=simple
User=qrx-agent
Group=qrx-agent
ExecStart=/opt/qrx-node-suite/bin/agentd -config /etc/qrx-node-suite/agent.json
WorkingDirectory=/opt/qrx-node-suite
Restart=always
RestartSec=2

# Self-update relies on this: a self-binary OTA update
# (docs/updates.md#self-binary-components) stages+promotes the new binary
# and then the Agent process exits; systemd restarting it here is what
# makes it actually run the new version, which then calls
# Manager.ResumeSelfUpdate to health-check and commit or roll back.

# Sandboxing -- narrow but not so narrow it can't manage qrxd or its own
# data. Adjust ReadWritePaths if your qrxd datadir lives elsewhere.
# qrx-agent uses the command-exact /etc/sudoers.d/qrx-agent rule to manage
# qrxd.service. NoNewPrivileges=true would block sudo's setuid transition
# before that narrow policy can be evaluated.
NoNewPrivileges=false
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/qrx-node-suite/var /etc/qrx-node-suite
# updates.Manager.Install and QRXCoreUpdateManager.Update both download an
# update artifact to os.CreateTemp("", ...) -- /tmp by default, which
# ProtectSystem=strict otherwise makes read-only for this unit like
# everything outside ReadWritePaths. Without this, every self-update or
# QRX Core update install fails at the download step.
PrivateTmp=true

[Install]
WantedBy=multi-user.target
